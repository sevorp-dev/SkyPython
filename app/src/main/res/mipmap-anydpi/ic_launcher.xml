<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon for Android 7.x (API 24/25), which has no adaptive icons (mipmap-anydpi-v26). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <!-- Same night-sky fade as ic_launcher_background (top to bottom). -->
            <gradient
                android:angle="270"
                android:centerColor="#FF0B1230"
                android:endColor="#FF1A2470"
                android:startColor="#FF070B1F" />
        </shape>
    </item>
    <!-- The foreground is drawn for a 108dp canvas; enlarge it so the 66dp safe zone fills the circle. -->
    <item
        android:bottom="-12dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:left="-12dp"
        android:right="-12dp"
        android:top="-12dp" />
</layer-list>
