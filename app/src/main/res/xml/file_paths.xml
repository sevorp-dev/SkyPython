<?xml version="1.0" encoding="utf-8"?>
<!-- Folders whose files can be shared through the FileProvider (share/Share.kt). -->
<paths>
    <files-path name="projects" path="projects/" />
    <cache-path name="run" path="run/" />
    <cache-path name="share" path="share/" />
    <!-- Figures plt.show() saved (the matplotlib backend, runtime PlotBackend). -->
    <cache-path name="plots" path="plots/" />
    <cache-path name="reports" path="reports/" />
    <!-- Downloaded updates, for the system installer when a session can't be used. -->
    <cache-path name="updates" path="updates/" />
    <!-- Projects opened from the phone's storage. Only files the user shares or opens with another
         app get a URI (with a one-off read grant); the provider is not exported. -->
    <external-path name="storage" path="." />
    <!-- Memory cards live outside external-path (/storage/XXXX-XXXX). -->
    <root-path name="volumes" path="storage/" />
</paths>
