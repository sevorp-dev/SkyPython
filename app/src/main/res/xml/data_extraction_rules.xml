<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same rules for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="python/" />
        <exclude domain="file" path="home/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="python/" />
        <exclude domain="file" path="home/" />
    </device-transfer>
</data-extraction-rules>
