<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6-11: back up user projects and settings, skip the unpacked Python runtime, language server and debugger (re-created from the APK) and crash reports (logs and stack traces stay on the phone). -->
<full-backup-content>
    <exclude domain="file" path="python/" />
    <exclude domain="file" path="home/" />
    <exclude domain="file" path="crash/" />
    <exclude domain="file" path="langserver/" />
    <exclude domain="file" path="debugger/" />
</full-backup-content>
