 },
 "tokenColors": [
  {
   "scope": [
    "meta.embedded",
    "source.groovy.embedded",
    "string meta.image.inline.markdown",
    "variable.legacy.builtin.python"
   ],
   "settings": {
    "foreground": "#DCE3F5"
   }
  },
  {
   "scope": "emphasis",
   "settings": {
    "fontStyle": "italic"
   }
  },
  {
   "scope": "strong",
   "settings": {
    "fontStyle": "bold"
   }
  },
  {
   "scope": "header",
   "settings": {
    "foreground": "#6EA8FF"
   }
  },
  {
   "scope": "comment",
   "settings": {
    "foreground": "#7584B4"
   }
  },
  {
   "scope": "constant.language",
   "settings": {
    "foreground": "#6EA8FF"
   }
  },
  {
   "scope": [
    "constant.numeric",
    "variable.other.enummember",
    "keyword.operator.plus.exponent",
    "keyword.operator.minus.exponent"
   ],
   "settings": {
    "foreground": "#F59AC2"
   }
  },
  {
