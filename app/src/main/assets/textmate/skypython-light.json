{
 "name": "SkyPython Light (derived from VS Code Dark+)",
 "type": "light",
 "colors": {
  "editor.background": "#FFFFFF",
  "editor.foreground": "#1F2329",
  "editor.inactiveSelectionBackground": "#E8EAED",
  "editor.selectionBackground": "#F28C3847",
  "editor.selectionHighlightBackground": "#F28C3824",
  "editor.lineHighlightBackground": "#F3F5F8",
  "editorCursor.foreground": "#D9700F",
  "editorLineNumber.foreground": "#9AA0A8",
  "editorLineNumber.activeForeground": "#3D434C",
  "editorIndentGuide.background": "#E6E8EB",
  "editorIndentGuide.background1": "#E6E8EB",
  "editorIndentGuide.activeBackground": "#C9CDD3",
  "editorIndentGuide.activeBackground1": "#C9CDD3",
  "highlightedDelimitersForeground": "#1F2329"
 },
 "tokenColors": [
  {
   "scope": [
    "meta.embedded",
    "source.groovy.embedded",
    "string meta.image.inline.markdown",
    "variable.legacy.builtin.python"
   ],
   "settings": {
    "foreground": "#1F2329"
   }
  },
  {
   "scope": "emphasis",
   "settings": {
    "fontStyle": "italic"
   }
  },
  {
   "scope": "strong",
   "settings": {
    "fontStyle": "bold"
   }
  },
  {
   "scope": "header",
   "settings": {
    "foreground": "#0033B3"
   }
  },
  {
   "scope": "comment",
   "settings": {
    "foreground": "#8C8C8C",
    "fontStyle": "italic"
   }
  },
  {
   "scope": "constant.language",
   "settings": {
    "foreground": "#0033B3"
   }
  },
  {
   "scope": [
    "constant.numeric",
    "variable.other.enummember",
    "keyword.operator.plus.exponent",
    "keyword.operator.minus.exponent"
   ],
   "settings": {
    "foreground": "#1750EB"
   }
  },
  {
   "scope": "constant.regexp",
   "settings": {
    "foreground": "#871094"
   }
  },
  {
   "scope": "entity.name.tag",
   "settings": {
    "foreground": "#0033B3"
   }
  },
  {
   "scope": [
    "entity.name.tag.css",
    "entity.name.tag.less"
   ],
   "settings": {
    "foreground": "#0037A6"
   }
  },
  {
   "scope": "entity.other.attribute-name",
   "settings": {
    "foreground": "#1F2329"
   }
  },
  {
   "scope": [
    "entity.other.attribute-name.class.css",
    "source.css entity.other.attribute-name.class",
    "entity.other.attribute-name.id.css",
    "entity.other.attribute-name.parent-selector.css",
    "entity.other.attribute-name.parent.less",
    "source.css entity.other.attribute-name.pseudo-class",
    "entity.other.attribute-name.pseudo-element.css",
    "source.css.less entity.other.attribute-name.id",
    "entity.other.attribute-name.scss"
   ],
   "settings": {
    "foreground": "#0037A6"
   }
  },
  {
   "scope": "invalid",
   "settings": {
    "foreground": "#C42B1C"
   }
  },
  {
   "scope": "markup.underline",
   "settings": {
    "fontStyle": "underline"
   }
  },
  {
   "scope": "markup.bold",
   "settings": {
    "fontStyle": "bold",
    "foreground": "#0033B3"
   }
  },
  {
   "scope": "markup.heading",
   "settings": {
    "fontStyle": "bold",
    "foreground": "#0033B3"
   }
  },
  {
   "scope": "markup.italic",
   "settings": {
    "fontStyle": "italic",
    "foreground": "#0033B3"
   }
  },
  {
   "scope": "markup.strikethrough",
   "settings": {
    "fontStyle": "strikethrough"
   }
  },
  {
   "scope": "markup.inserted",
   "settings": {
    "foreground": "#1750EB"
   }
  },
  {
   "scope": "markup.deleted",
   "settings": {
    "foreground": "#067D17"
   }
  },
  {
   "scope": "markup.changed",
   "settings": {
    "foreground": "#0033B3"
   }
  },
  {
   "scope": "punctuation.definition.quote.begin.markdown",
   "settings": {
    "foreground": "#8C8C8C"
   }
  },
  {
   "scope": "punctuation.definition.list.begin.markdown",
   "settings": {
    "foreground": "#00627A"
   }
  },
  {
   "scope": "markup.inline.raw",
   "settings": {
    "foreground": "#067D17"
   }
  },
  {
   "name": "brackets of XML/HTML tags",
   "scope": "punctuation.definition.tag",
   "settings": {
    "foreground": "#8C8C8C"
   }
  },
  {
   "scope": [
    "meta.preprocessor",
    "entity.name.function.preprocessor"
   ],
   "settings": {
    "foreground": "#0033B3"
   }
  },
  {
   "scope": "meta.preprocessor.string",
   "settings": {
    "foreground": "#067D17"
   }
  },
  {
   "scope": "meta.preprocessor.numeric",
   "settings": {
    "foreground": "#1750EB"
   }
  },
  {
   "scope": "meta.structure.dictionary.key.python",
   "settings": {
    "foreground": "#1F2329"
   }
  },
  {
   "scope": "meta.diff.header",
   "settings": {
    "foreground": "#0033B3"
   }
  },
  {
   "scope": "storage",
   "settings": {
    "foreground": "#0033B3"
   }
  },
  {
   "scope": "storage.type",
   "settings": {
    "foreground": "#0033B3"
   }
  },
  {
   "scope": [
    "storage.modifier",
    "keyword.operator.noexcept"
   ],
   "settings": {
    "foreground": "#0033B3"
   }
  },
  {
   "scope": [
    "string",
    "meta.embedded.assembly"
   ],
   "settings": {
    "foreground": "#067D17"
   }
  },
  {
   "scope": "string.tag",
   "settings": {
    "foreground": "#067D17"
   }
  },
  {
   "scope": "string.value",
   "settings": {
    "foreground": "#067D17"
   }
  },
  {
   "scope": "string.regexp",
   "settings": {
    "foreground": "#A3311C"
   }
  },
  {
   "name": "String interpolation",
   "scope": [
    "punctuation.definition.template-expression.begin",
    "punctuation.definition.template-expression.end",
    "punctuation.section.embedded"
   ],
   "settings": {
    "foreground": "#0033B3"
   }
  },
  {
   "name": "Reset JavaScript string interpolation expression",
   "scope": [
    "meta.template.expression"
   ],
   "settings": {
    "foreground": "#1F2329"
   }
  },
  {
   "scope": [
    "support.type.vendored.property-name",
    "support.type.property-name",
    "source.css variable",
    "source.coffee.embedded"
   ],
   "settings": {
    "foreground": "#1F2329"
   }
  },
  {
   "scope": "keyword",
   "settings": {
    "foreground": "#0033B3"
   }
  },
  {
   "scope": "keyword.control",
   "settings": {
    "foreground": "#0033B3"
   }
  },
  {
   "scope": "keyword.operator",
   "settings": {
    "foreground": "#1F2329"
   }
  },
  {
   "scope": [
    "keyword.operator.new",
    "keyword.operator.expression",
    "keyword.operator.cast",
    "keyword.operator.sizeof",
    "keyword.operator.alignof",
    "keyword.operator.typeid",
    "keyword.operator.alignas",
    "keyword.operator.instanceof",
    "keyword.operator.logical.python",
    "keyword.operator.wordlike"
   ],
   "settings": {
    "foreground": "#0033B3"
   }
  },
  {
   "scope": "keyword.other.unit",
   "settings": {
    "foreground": "#1750EB"
   }
  },
  {
   "scope": [
    "punctuation.section.embedded.begin.php",
    "punctuation.section.embedded.end.php"
   ],
   "settings": {
    "foreground": "#0033B3"
   }
  },
  {
   "scope": "support.function.git-rebase",
   "settings": {
    "foreground": "#1F2329"
   }
  },
  {
   "scope": "constant.sha.git-rebase",
   "settings": {
    "foreground": "#1750EB"
   }
  },
  {
   "name": "coloring of the Java import and package identifiers",
   "scope": [
    "storage.modifier.import.java",
    "variable.language.wildcard.java",
    "storage.modifier.package.java"
   ],
   "settings": {
    "foreground": "#1F2329"
   }
  },
  {
   "name": "this.self",
   "scope": "variable.language",
   "settings": {
    "foreground": "#0033B3"
   }
  },
  {
   "name": "Function declarations",
   "scope": [
    "entity.name.function",
    "support.function",
    "support.constant.handlebars",
    "source.powershell variable.other.member",
    "entity.name.operator.custom-literal"
   ],
   "settings": {
    "foreground": "#00627A"
   }
  },
  {
   "name": "Types declaration and references",
   "scope": [
    "support.class",
    "support.type",
    "entity.name.type",
    "entity.name.namespace",
    "entity.other.attribute",
    "entity.name.scope-resolution",
    "entity.name.class",
    "storage.type.numeric.go",
    "storage.type.byte.go",
    "storage.type.boolean.go",
    "storage.type.string.go",
    "storage.type.uintptr.go",
    "storage.type.error.go",
    "storage.type.rune.go",
    "storage.type.cs",
    "storage.type.generic.cs",
    "storage.type.modifier.cs",
    "storage.type.variable.cs",
    "storage.type.annotation.java",
    "storage.type.generic.java",
    "storage.type.java",
    "storage.type.object.array.java",
    "storage.type.primitive.array.java",
    "storage.type.primitive.java",
    "storage.type.token.java",
    "storage.type.groovy",
    "storage.type.annotation.groovy",
    "storage.type.parameters.groovy",
    "storage.type.generic.groovy",
    "storage.type.object.array.groovy",
    "storage.type.primitive.array.groovy",
    "storage.type.primitive.groovy"
   ],
   "settings": {
    "foreground": "#007A7A"
   }
  },
  {
   "name": "Types declaration and references, TS grammar specific",
   "scope": [
    "meta.type.cast.expr",
    "meta.type.new.expr",
    "support.constant.math",
    "support.constant.dom",
    "support.constant.json",
    "entity.other.inherited-class",
    "punctuation.separator.namespace.ruby"
